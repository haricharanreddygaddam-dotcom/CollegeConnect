# CampusConnect environment configuration
#
# Copy this file to .env for local development.
# Never commit the real .env file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Replace with a unique random secret of at least 32 bytes.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-bytes-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------------------------------------------------
# Development/demo behavior
# ---------------------------------------------------------------------------

# Keep false outside local presentations.
ENABLE_DEMO_ACCOUNTS=false

# Seed demo data automatically in development/test.
# MUST remain false in production.
AUTO_SEED=true

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Local development default:
# DATABASE_URL=sqlite:///./campusconnect.db

# Production example:
# DATABASE_URL=postgresql+psycopg2://campusconnect:CHANGE_ME@127.0.0.1:5432/campusconnect

# ---------------------------------------------------------------------------
# Frontend/API security
# ---------------------------------------------------------------------------

# Comma-separated values are not supported by the current list-based
# Pydantic settings field. Configure CORS_ORIGINS as a JSON list.
#
# Development defaults are already defined in config.py.
#
# Production example:
# CORS_ORIGINS=["https://campusconnect.example.com"]

# Enable only when the production API is served exclusively over HTTPS.
ENABLE_HSTS=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

HOST=127.0.0.1
PORT=8000
WORKERS=1
