# Copy this file to .env for local development.
# Replace SECRET_KEY with a unique random value of at least 32 bytes.
SECRET_KEY=replace-this-with-a-random-secret-at-least-32-bytes-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: override the default SQLite database.
# DATABASE_URL=sqlite:///./campusconnect.db
